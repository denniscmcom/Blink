#include "SHARED.bt"

LittleEndian();

typedef struct
{
	float x;
	float y;
	float z;
} Vector3;

typedef struct
{
	float x;
	float y;
} Vector2;

typedef struct
{
	Vector3 position;
	Vector3 normal;
	Vector3 tangent;
	Vector3 bitangent;
	Vector2 texture_coord;
} Vertex;

typedef struct
{
	uint32 vertex_count;
	uint32 index_count;
	Vertex vertices[vertex_count];
	uint32 indices[index_count];
} Mesh;

Header header;

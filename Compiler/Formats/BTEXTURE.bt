LittleEndian();

typedef struct
{
	char blink_magic[4];
	char file_magic[4];
	uint8 version;
} Header;

typedef struct
{
	uint8 r;
	uint8 g;
	uint8 b;
	uint8 a;
} Color_RGBA;

typedef struct
{
	uint32 width;
	uint32 height;
	Color_RGBA pixels[width * height];
} Texture;

Header header;
Texture texture;
